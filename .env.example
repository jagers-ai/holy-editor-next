# 🍞 Bread Recipe Calculator - Environment Variables

# 📚 Database (Supabase)
#
# Vercel Production 필수 설정 (Supabase + PgBouncer)
# - Vercel의 서버리스 환경은 Supabase Connection Pooler(6543 포트)를 사용해야 합니다.
# - 반드시 DATABASE_URL 끝에 `?pgbouncer=true`를 붙이세요.
# - DIRECT_URL은 마이그레이션 등 직접 연결용으로 5432 포트를 사용합니다.
# 예시:
# DATABASE_URL="postgresql://postgres:[password]@[project-id].supabase.co:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[password]@[project-id].supabase.co:5432/postgres"
# (옵션) 연결 난립 이슈가 있으면 `&connection_limit=1` 추가 고려
# DATABASE_URL="...:6543/postgres?pgbouncer=true&connection_limit=1"

DATABASE_URL="postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[password]@[host]:5432/postgres"

# 📊 Analytics
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_key_here"

# 🔍 Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your_auth_token_here_optional"

# 🚀 Deployment
NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA="auto_generated_by_vercel"

# Supabase (Auth/Client)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
